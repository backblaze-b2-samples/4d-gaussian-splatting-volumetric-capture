# Backblaze B2 (required) — S3-compatible API
B2_APPLICATION_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
# Region slug from your bucket's S3 endpoint. The S3 endpoint is derived from
# it as https://s3.<B2_REGION>.backblazeb2.com — there is no separate endpoint var.
B2_REGION=your-region

# Optional: base URL for building PUBLIC object links (public buckets only).
# The app runs fine without it; leave it commented for a private bucket.
# B2_PUBLIC_URL_BASE=https://your-bucket.s3.your-region.backblazeb2.com

# Where each value comes from in the B2 dashboard (illustrative shapes only —
# these are NOT real credentials):
#   B2_APPLICATION_KEY_ID  -> the "keyID" shown when you create an application key
#   B2_APPLICATION_KEY     -> the "applicationKey" secret, shown only once
#   B2_BUCKET_NAME         -> the bucket's unique name (e.g. my-4dgs-captures)
#   B2_REGION              -> the region slug in the bucket's S3 endpoint (e.g. us-east-005)

# Optional: path to a local clone of hustvl/4DGaussians (the CUDA-only training
# engine). Only needed to run the train/export stages on a CUDA host; the
# CPU-runnable stages (ingest, frames, calibration, dataset staging, B2 I/O)
# never touch it. Set automatically by scripts/setup_engine.sh.
# FOURDGS_REPO_DIR=/path/to/4DGaussians

# Frontend → API base URL. Defaults to http://localhost:8000 for local dev;
# set this to the deployed API origin in production (Next.js inlines it at
# build time, so it must be present when `pnpm build` runs).
# NEXT_PUBLIC_API_URL=https://your-api.example.com
